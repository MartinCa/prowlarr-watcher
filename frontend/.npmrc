# Scope mapping only. The _authToken deliberately does not live here: pnpm 11
# ignores an environment-variable credential in a committed project .npmrc.
# Docker builds write it to a user-level npmrc (see the Dockerfile); for local
# development put it in your own ~/.npmrc:
#   echo "//npm.pkg.github.com/:_authToken=$(gh auth token)" >> ~/.npmrc
@martinca:registry=https://npm.pkg.github.com
